<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- the theme of the system, light or dark as the system is, without a title bar (the app has its own row of buttons) -->
	<style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
		<item name="android:windowNoTitle">true</item>
		<item name="android:windowActionBar">false</item>
		<item name="android:windowBackground">@color/window</item>
		<item name="android:statusBarColor">@color/window</item>
		<item name="android:navigationBarColor">@color/window</item>
	</style>
	<color name="window">#18181b</color>
	<color name="icon_background">#0684c7</color>
</resources>
